        {
         "type": "null"
        }
       ],
       "title": "Min Amount"
      }
     },
     {
      "name": "max_amount",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Max Amount"
      }
     },
     {
      "name": "direction",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "debit",
          "credit"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Direction"
      }
     },
     {
      "name": "category",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Category"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
